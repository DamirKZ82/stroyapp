# Скопируй этот файл в .env и заполни значения.
# .env в репозиторий не коммитится.

# Окружение: dev | stage | prod
STROYAPP_ENV=dev

# PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/stroyapp — перекрывает DB_* ниже
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stroyapp
DB_USER=stroyapp_user
DB_PASSWORD=change_me

# JWT — сгенерируй командой: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_hex_string

# Ключ шифрования секретов в базе (ключи кассы, SMS, Telegram задаются в
# админке → «Настройки»). Сгенерируй: openssl rand -hex 32. Потеряешь или
# сменишь — секреты в базе придётся ввести заново. Пусто = выводится из
# JWT_SECRET (тогда то же самое при смене JWT_SECRET).
SETTINGS_KEY=

# Хранилище загрузок
UPLOADS_ROOT=./uploads

# ---- Ниже — запасной вариант для старых выкладок. Удобнее задавать в
# админке → «Настройки»: значение оттуда перекрывает .env. ----

# Telegram-уведомления об ошибках (опционально; пусто = не отправляем)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2GIS API key (нужен мобильному приложению; бэк пробрасывает клиенту при необходимости)
TWOGIS_API_KEY=

# ---- Оплата тарифа Pro картой: Freedom Pay (libs/payments.py) ----
# Ключи кассы — в личном кабинете Freedom Pay. Пусто = на проде «оплата
# пока недоступна», в dev — тестовая страница «Оплатить» без денег.
# FREEDOMPAY_TESTING=1 — тестовый режим кассы: первая проверка на проде.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
FREEDOMPAY_TESTING=0
# Цена Pro за месяц, ₸ (за 3 и 12 месяцев — скидка)
PRO_MONTH_PRICE=9900

# ---- Демо-вход для ревью Google Play / App Store ----
# Ревьюеру стора недоступен казахстанский номер, поэтому для одного
# номера код фиксирован и SMS не отправляется. Тот же номер и код
# указываются в Play Console (App access) и App Store Connect
# (App Review Information).
# Пусто = функция выключена. Код — строго 4 цифры.
# Включать на время ревью, после публикации убирать.
REVIEW_PHONE=
REVIEW_CODE=
